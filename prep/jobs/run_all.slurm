#!/bin/bash --login
#SBATCH --job-name=asi_fimsa_prep
#SBATCH --account=a_imb_cpdg
#SBATCH --partition=general
#SBATCH --qos=normal
#SBATCH --time=02:00:00
#SBATCH --mem=64G
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH -o /scratch/user/uqxtan9/analysis_project/ASI_FIMSA_workshop/runs/slurm_%x_%j.out
#SBATCH -e /scratch/user/uqxtan9/analysis_project/ASI_FIMSA_workshop/runs/slurm_%x_%j.err
#
# Build every Atera Staged dataset from the RDM bundle, end to end.
#
#   sbatch prep/jobs/run_all.slurm            # everything, both gates re-derived
#   sbatch prep/jobs/run_all.slurm 03 04 05   # rebuild only these steps
#
# Submit from /scratch, never from /QRISdata. Nothing here uploads anything --
# see prep/upload_to_origins.sh for that, and read its licence gate first.
#
# The two HUMAN GATES (prep/atera_cluster_annotation.csv after 01,
# prep/crop_window.json after 02) are regenerated by this job. Steps 01 and 02
# preserve any manual_override a reviewer typed in, but a full rerun still means
# a person should re-read the QC figures before the artifacts are published.

set -euo pipefail

REPO=/scratch/user/uqxtan9/analysis_project/ASI_FIMSA_workshop
PREP="$REPO/prep"
PY=/home/uqxtan9/micromamba/envs/MELagent/bin/python

mkdir -p "$REPO/runs"

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export NUMEXPR_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

# Heavy intermediates (staged RDM copies, the unpacked zarr, the panel cache)
# live in $TMPDIR: GPFS, 10 TB quota, auto-cleaned at job end.
export PREP_WORK="${TMPDIR:?TMPDIR unset -- run this under SLURM}/asi_fimsa_prep"
export PREP_OUT="${PREP_OUT:-/scratch/project_mnt/S0010/Xiao/asi_fimsa_workshop/staged}"
mkdir -p "$PREP_WORK" "$PREP_OUT"

STEPS=("$@")
if [[ ${#STEPS[@]} -eq 0 ]]; then
  STEPS=(00 01 02 03 04 05)
fi

echo "node       : $(hostname)"
echo "job        : ${SLURM_JOB_ID:-none}  cpus=${SLURM_CPUS_PER_TASK:-?}"
echo "PREP_WORK  : $PREP_WORK"
echo "PREP_OUT   : $PREP_OUT"
echo "steps      : ${STEPS[*]}"
echo

cd "$PREP"
for step in "${STEPS[@]}"; do
  script=$(ls "$PREP"/"${step}"_*.py)
  echo "=============================================================="
  echo "== $(basename "$script")   $(date -Is)"
  echo "=============================================================="
  # No pipe and no `|| true` here on purpose: `set -e` must abort the job on a
  # failing step rather than carrying a half-built artifact into the next one.
  start=$SECONDS
  "$PY" "$script"
  echo "-- $(basename "$script") finished in $((SECONDS - start))s"
  echo
done

echo "=============================================================="
echo "artifacts in $PREP_OUT"
ls -la "$PREP_OUT"
echo
echo "NOT uploaded. prep/upload_to_origins.sh is gated on the Atera licence."
